function Stage_Select_icon_generate(_roon, _x, _y, _icon, _music, _intro_art, _description, _up, _down, _left, _right, _reward = undefined) constructor{
	rm = _roon       
	x = _x
	y = _y
	icon = _icon
	music = _music
	intro = _intro_art
	intro_text = _description
	
	reward = _reward;
	
	up = _up
	down = _down
	left = _left
	right = _right
}		